+<div class="grid"><div class="card"><h3>原播放</h3><canvas id="before" width="192" height="208"></canvas><p id="a"></p></div><div class="card"><h3>修复后</h3><canvas id="after" width="192" height="208"></canvas><p id="b"></p></div></div>
