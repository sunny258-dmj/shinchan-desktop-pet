+        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
+        w, h = float(self.width()), float(self.height())
+        r = 22.0
+        tw = 11.0
+        tail_h = 13.0
+        hp = 2.0
+        L = T = hp
+        tx = w / 2.0 if self.tail_x < 0 else float(min(max(self.tail_x, 30), w - 30))
+
+        # 一体式漫画气泡轮廓，尾巴与卡体同一条 path，缩放时不会开缝。
+        path = QPainterPath()
+        if self.tail_up:
+            B = h - hp
+            Tb = tail_h + hp
+            path.moveTo(L + r, Tb)
+            path.lineTo(tx - tw, Tb)
+            path.lineTo(tx, hp)
+            path.lineTo(tx + tw, Tb)
+            path.lineTo(w - hp - r, Tb)
+            path.arcTo(QRectF(w - hp - 2 * r, Tb, 2 * r, 2 * r), 90, -90)
+            path.lineTo(w - hp, B - r)
+            path.arcTo(QRectF(w - hp - 2 * r, B - 2 * r, 2 * r, 2 * r), 0, -90)
+            path.lineTo(L + r, B)
+            path.arcTo(QRectF(L, B - 2 * r, 2 * r, 2 * r), 270, -90)
+            path.lineTo(L, Tb + r)
+            path.arcTo(QRectF(L, Tb, 2 * r, 2 * r), 180, -90)
+        else:
+            B = h - tail_h - hp
+            path.moveTo(L + r, T)
+            path.lineTo(w - hp - r, T)
+            path.arcTo(QRectF(w - hp - 2 * r, T, 2 * r, 2 * r), 90, -90)
+            path.lineTo(w - hp, B - r)
+            path.arcTo(QRectF(w - hp - 2 * r, B - 2 * r, 2 * r, 2 * r), 0, -90)
+            path.lineTo(tx + tw, B)
+            path.lineTo(tx, h - hp)
+            path.lineTo(tx - tw, B)
+            path.lineTo(L + r, B)
+            path.arcTo(QRectF(L, B - 2 * r, 2 * r, 2 * r), 270, -90)
+            path.lineTo(L, T + r)
+            path.arcTo(QRectF(L, T, 2 * r, 2 * r), 180, -90)
+        path.closeSubpath()
+
+        accent = QColor(self._accent)
+        light = accent.lighter(190)
+        grad = QLinearGradient(0, T, 0, h)
+        grad.setColorAt(0.00, QColor(255, 255, 255, 253))
+        grad.setColorAt(0.42, QColor(light.red(), light.green(), light.blue(), 246))
+        grad.setColorAt(1.00, QColor(accent.red(), accent.green(), accent.blue(), 72))
+        p.setPen(QPen(accent.darker(108), 2.6))
+        p.setBrush(QBrush(grad))
+        p.drawPath(path)
+
+        # 顶部高光 + 右上三颗装饰点，接近小新贴纸气泡的亮面质感。
+        p.setPen(QPen(QColor(255, 255, 255, 185), 1.4))
+        p.setBrush(Qt.BrushStyle.NoBrush)
+        p.drawPath(path)
+        p.setPen(Qt.PenStyle.NoPen)
+        for i, a in enumerate((185, 120, 70)):
+            c = QColor(accent)
+            c.setAlpha(a)
+            p.setBrush(c)
+            p.drawEllipse(QPoint(int(w - 24 - i * 9), int((tail_h if self.tail_up else 0) + 13)), 3, 3)
