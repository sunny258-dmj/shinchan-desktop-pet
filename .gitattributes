# Binary assets - never touch line endings
*.png binary
*.webp binary
*.b64 binary
*.ico binary

# Windows-native scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Cross-platform sources normalized to LF
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.gitignore text eol=lf
